NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://shop.example.com
TRUST_PROXY=true

# Required OpenMU integration
OPENMU_DATABASE_URL=postgresql://openmu:change-me@postgres:5432/openmu
OPENMU_API_URL=https://admin.example.com
OPENMU_API_KEY=replace-with-cash-shop-role-api-key
DB_POOL_MAX=20
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Required security settings
SESSION_SECRET=replace-with-at-least-64-random-characters
ADMIN_ACCOUNTS=
CF_TURNSTILE_SECRET_KEY=
VITE_CF_TURNSTILE_SITE_KEY=
REDIS_URL=redis://:replace-me@redis:6379/0
AUDIT_LOG_PATH=/app/logs/audit.ndjson

# Keep disabled until provider credentials and sandbox tests are complete
PAYMENTS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_USE_SANDBOX=true
PAYPAL_LIVE_ENABLED=false
TRUEMONEY_ENABLED=false
TRUEMONEY_PROVIDER_API_URL=
TRUEMONEY_PROVIDER_API_KEY=
CARDS_ENABLED=false

REDIS_CATALOG_TTL_SECONDS=300
