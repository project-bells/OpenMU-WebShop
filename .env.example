# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENMU-ORIGINS INTEGRATION (https://github.com/project-bells/OpenMU-Origins.git)
# Base URL of the OpenMU-Origins AdminPanel / Public API server (default port 80 / 5000)
OPENMU_API_URL="http://localhost:5000"
# 32+ character API key configured in OpenMU-Origins AdminPanel -> API Keys (Header: X-Api-Key)
OPENMU_API_KEY="openmu_origins_secret_api_key_32chars_min"
# Optional direct PostgreSQL connection string for OpenMU-Origins (Schema: data."Account", data."ItemStorage")
OPENMU_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openmu"

# PAYPAL REST API CONFIGURATION (Matches OpenMU-Origins WebShopOptions)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_USE_SANDBOX="true"

# TRUEMONEY WALLET CONFIGURATION (Angpao Voucher & Webhook)
TRUEMONEY_MERCHANT_PHONE="0891234567"
TRUEMONEY_WEBHOOK_SECRET=""

# CLOUDFLARE TURNSTILE (Bot Defense & Pre-Login Challenge)
# Obtain Site Key and Secret Key from: https://dash.cloudflare.com/?to=/:account/turnstile
# Universal Cloudflare Testing Site Key (Always Passes): 1x00000000000000000000AA
VITE_CF_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
CF_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# Universal Cloudflare Testing Secret Key (Always Passes): 1x0000000000000000000000000000000AA
CF_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

